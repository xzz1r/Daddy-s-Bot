# Número de teléfono del dueño del bot (sin + ni espacios)
# Ejemplo: 5491112345678 (Argentina) o 521234567890 (México)
OWNER_NUMBER=5491100000000

# Co-owners: mismos privilegios que el dueño. Separados por coma, sin + ni
# espacios. Opcional. Ejemplo: CO_OWNERS=34600000000,5491112345678
CO_OWNERS=

# Números con los que el !ship del owner sale ALTO (62-89) en vez del 0-12 que
# le sale con todo el mundo. Varios separados por coma, con o sin + ni espacios.
# Opcional y vacío por defecto.
#
# No van en el código a propósito: son números de terceros y el repositorio se
# lee. Mismo motivo que CO_OWNERS.
SHIP_ALTO=

# Número de contacto que enseña el menú, solo dígitos y sin el +. VACÍO POR
# DEFECTO: sin esto, el menú no enseña ninguna línea de contacto. No lo pongas
# si quieres que el bot no lleve a nadie.
CONTACTO=

# ─── El día del bot ─────────────────────────────────────────────────────────
# De aquí cuelgan la racha, el objetivo del día y los bonos por actividad.
#
# Por defecto corta a medianoche de Nueva York, que es lo que había. Para un
# grupo que habla castellano eso significa que el día nuevo empieza a las 6 de
# la mañana en España, y que la hora local del corte SE MUEVE una hora dos
# veces al año, porque EE. UU. cambia de horario en otras fechas.
#
# Cambiarlo mueve el corte para todo el mundo y rompe las rachas en curso, así
# que es una decisión, no un ajuste.
# DIA_ZONA=Europe/Madrid
# DIA_HORA_CORTE=0

# Barrido inicial de fotos de perfil (el que alimenta !fk). Por defecto espera
# media hora y NO se hace si la sesión es de hoy: una cuenta recién vinculada
# pidiendo la foto de todo el grupo se parece demasiado a un raspador.
# Ponlo a "ya" solo si sabes por qué lo necesitas ahora.
# BARRIDO_INICIAL=ya

# Búsqueda facial de !fk. Opcionales las dos: sin ellas, !fk solo da los
# enlaces manuales. LENSO_API_KEY es de lenso.ai (plan Developer);
# FACECHECK_API_KEY es de facecheck.id y es de pago por búsqueda.
LENSO_API_KEY=
FACECHECK_API_KEY=

# Fuente principal de !play: API de terceros que baja el audio de YouTube en SU
# servidor (IP limpia, sin bot-check). Registro gratis en rapidapi.com,
# suscríbete a "YouTube MP3" (ytjar) plan Basic/gratuito, copia tu key.
# Sin esta key, !play usa solo SoundCloud como respaldo.
#
# Admite VARIAS keys separadas por coma: el bot SUMA los cupos gratis y rota
# solo cuando una agota su cuota mensual. Con 2 keys ya superas las 1000/mes.
# Ejemplo: RAPIDAPI_KEY=key_de_cuenta1,key_de_cuenta2
RAPIDAPI_KEY=
# Opcional: cambiar de proveedor sin tocar código (host de RapidAPI).
# RAPIDAPI_HOST=youtube-mp36.p.rapidapi.com

# ─── Ajustes finos, todos opcionales ────────────────────────────────────────
# Con "verbose" el bot escribe también las líneas informativas (sondeos,
# indexado, decisiones internas). Por defecto solo salen avisos y errores, que
# es lo que hace que el log se lea. Útil para diagnosticar algo concreto.
# LOG_LEVEL=verbose

# Cuánto disco puede ocupar la caché de fotos de perfil, en MB. Por defecto 60.
# En una VPS con el disco justo, bajarlo es de lo primero que se toca.
# PFP_CACHE_MB=60

# Fuente de los gifs de !fuck. VACIA por defecto: sin esto, !fuck trae imagenes
# de la misma web SFW que el resto de acciones y el chiste queda en las frases.
#
# Acepta la direccion de cualquier API de gifs de anime. Si la categoria va en
# medio de la ruta, se marca con {cat}; si va al final, no hace falta poner nada:
#
#   ACCION_NSFW_API=https://loquesea.site/api/img/nsfw/{cat}/gif
#   ACCION_NSFW_API=https://otra.web/api/v2/
#
# El bot se apaña con las tres formas de contestar que usan estas APIs (`url`,
# `link` o `results[]`) y con lo que devuelvan: gif, mp4 o imagen fija. Si la web
# falla, el comando devuelve el aura y no cobra.
#
# LA CATEGORIA QUE PIDE CAMBIA CON LA FUENTE, y eso ya esta resuelto: sin esta
# variable *!fuck* pide `kiss` a la web de serie, que es lo unico parecido que
# tiene; con la variable puesta pide `fuck`, que es como la llaman las webs del
# otro tipo. Es lo que se marca con {cat}. Si la web que pongas la llama de otra
# forma, se cambia en `catNsfw`, en src/commands/acciones.js.
#
# No viene rellena: a que web se conecta el bot —y por tanto que puede acabar
# mandando al grupo sin que nadie lo revise— lo decide el dueño, no el codigo.
ACCION_NSFW_API=

# ─── VIDEOS DE TIKTOK, INSTAGRAM Y PINTEREST (!tt, !ig, !pin) ────────────────
#
# UNA POR PLATAFORMA, Y TODAS OPCIONALES. Sin ninguna, los tres comandos tiran
# de yt-dlp y funcionan igual; con ellas van por delante.
#
# POR QUE HACEN FALTA en TikTok e Instagram: el servicio baja el video en SU
# maquina, no en la nuestra. Las dos bloquean a las IP de datacenter —y esto
# corre en una VPS de Oracle—, asi que pedirselo directamente no es una via
# peor: es una via cerrada.
#
# PINTEREST NO LA NECESITA. Tiene via propia: se lee la pagina del pin y se saca
# el medio de sus etiquetas og:, que sirve igual para foto que para video. Se
# deja la variable por si algun dia hace falta.
#
# Se le pasa la direccion del post. Si la URL va en medio, se marca con {url};
# si no, se anyade sola como ?url=...
#
#   TIKTOK_API=https://loquesea.site/api?link={url}
#   INSTAGRAM_API=https://otra.web/download
#
# Se aceptan las formas habituales de contestar (`url`, `link`, `video`,
# `download`, `data.play`, `result.url`). Si una falla, se cae a yt-dlp sin
# ruido: un servicio de terceros que se cae un martes no puede dejar el comando
# muerto hasta que alguien mire este fichero.
#
# REDES_API vale para las tres a la vez y solo se usa donde no haya una propia.
#
# LA MARCA DE AGUA no depende de esto: en TikTok el video limpio y el marcado
# son dos formatos del mismo enlace, y el selector de yt-dlp descarta el marcado
# por su nombre (ver src/utils/redes.js). Si pones una API, comprueba que la
# suya tambien lo devuelve limpio.
#
# YT-DLP, para lo que no tenga API. Se actualiza con `pip install -U yt-dlp`;
# estas webs cambian a menudo y una version vieja deja de sacar el video sin
# decir por que. `npm run estado` avisa si falta o si es muy antigua.
TIKTOK_API=
INSTAGRAM_API=
PINTEREST_API=
REDES_API=

# ─── EL VIDEO EN HD, Y POR QUE NO VIENE PUESTO ──────────────────────────────
#
# En TikTok el mismo enlace tiene DOS videos, y no se parecen:
#
#   normal   576x1024   H.264   1,1 MB
#   HD      1080x1920   HEVC    1,5 MB
#
# El bot pide siempre el mejor. Pero el HD viene en HEVC (H.265) y eso NO es
# intercambiable: WhatsApp reproduce H.264 en todas partes y el HEVC se le
# atraganta segun el telefono. Un video de 1080 que a media docena del grupo no
# se les abre es peor que uno de 576 que ve todo el mundo, asi que por defecto,
# si el mejor viene en HEVC, se coge el siguiente.
#
# Si en tu grupo todos llevan telefonos modernos, esto lo cambia:
#
#   REDES_HEVC=1
#
# Y con el proveedor de TikTok hay que PEDIR el HD, que si no no lo manda. Se
# hace anyadiendo &hd=1 al final de TIKTOK_API:
#
#   TIKTOK_API=https://www.tikwm.com/api/?url={url}&hd=1
REDES_HEVC=

# ─── EL GUARDIÁN ────────────────────────────────────────────────────────────
#
# Una segunda cuenta cuyo unico trabajo es devolverle el admin al bot cuando
# alguien se lo quita. Existe porque el bot no puede defenderse de eso solo:
# sin admin no tiene permiso para reponerse ni para degradar a quien se lo
# quito, y de paso se queda sin borrar enlaces, sin borrar historias y sin
# poder expulsar.
#
# Son DOS variables, una en cada lado, y las dos hacen falta:
#
#   GUARDIAN      El numero de la cuenta guardiana, para que el bot le devuelva
#                 el admin a ella si se lo quitan. Se protegen los dos: asi hay
#                 que degradar a los dos en menos de lo que tardan en reponerse,
#                 que es un segundo. ESTA SI HACE FALTA.
#   GUARDIAN_DE   El numero del bot. NO HACE FALTA PONERLA: el bot anota su
#                 propio numero al conectar (data/numeroBot.json) y el guardian
#                 lo lee de ahi. Solo se rellena si el guardian corre en OTRA
#                 maquina y no tiene ese fichero delante. Puesta, manda ella.
#
# SE PUEDE CORRER EN OTRA MAQUINA, Y ES LO RECOMENDABLE cuando el numero es de
# otra persona. Un dispositivo vinculado de WhatsApp no es un permiso recortado:
# es una sesion completa de esa cuenta, igual que WhatsApp Web. Lo que la limita
# es el codigo que corre encima, no un permiso que WhatsApp conceda. Si esa
# sesion vive en el servidor del dueño del bot, esa persona esta confiando en el
# dueño, no en WhatsApp.
#
# Corriendolo en SU maquina, la sesion no sale de sus manos y protege igual: los
# dos procesos escuchan los eventos del grupo por su cuenta, no se hablan entre
# ellos. Y no hace falta que se clone el bot — el guardian es UN fichero con una
# sola dependencia:
#
#   mkdir guardian && cd guardian
#   curl -O https://raw.githubusercontent.com/xzz1r/Daddy-s-Bot/main/src/guardian.js
#   npm init -y && npm install @whiskeysockets/baileys --omit=optional
#   GUARDIAN=<su numero> GUARDIAN_DE=<el del bot> node guardian.js
#
# Son 31 MB de dependencias contra los 125 MB del bot. Ahi GUARDIAN_DE SI hace
# falta: sin el data/ del bot delante, no hay de donde leer el numero.
#
# SE VINCULA POR CODIGO, SIN QR NI CAMARA. Con GUARDIAN puesta, el guardian
# sabe su propio numero y pide el codigo el solo la primera vez:
#
#   node src/guardian.js
#
# Saca ocho caracteres. En el movil de ese numero:
#   WhatsApp -> Dispositivos vinculados -> Vincular un dispositivo
#   -> "Vincular con el numero de telefono" -> se teclea el codigo.
#
# Ten el movil ABIERTO en esa pantalla antes de lanzarlo: el codigo caduca en un
# par de minutos y encadenar peticiones es lo que agrava una restriccion de
# cuenta (por eso para solo tras tres sin usar). Cuando diga "guardian en linea",
# Ctrl+C y ya vive en pm2:
#
#   pm2 start ecosystem.config.js --only guardian
#   pm2 save
#
# Guarda su sesion en data/authGuardian y no comparte ni una credencial con el
# bot. No lee mensajes, no responde comandos y no manda nada al grupo.
#
# LO QUE EL GRUPO VE: WhatsApp anuncia quien asciende a quien, asi que cada
# reposicion deja escrito "<el guardian> ha nombrado admin a <el bot>". Eso ATA
# las dos cuentas a la vista de todos. No hay forma de ascender a nadie en
# silencio: quien ponga aqui su numero personal tiene que saberlo antes.
#
# Vacias no pasa nada: quitarle el admin al bot sigue costando la deuda —se
# cobra en cuanto se lo devuelvan— pero no se repone solo.
#   GUARDIAN_LID  El @lid del bot: el identificador interno que WhatsApp le da
#                 dentro de un grupo. TAMPOCO hace falta ponerla —el bot lo
#                 anota junto a su numero al conectar— y solo se rellena si el
#                 guardian corre en otra maquina. Importa mas de lo que parece:
#                 en un grupo LID, que son todos los de ahora, la degradacion
#                 del bot llega identificada SOLO por su @lid, sin telefono al
#                 lado. Sin esto el guardian ve la degradacion y no reconoce a
#                 nadie.
GUARDIAN=
GUARDIAN_DE=
GUARDIAN_LID=
