node_modules/
data/auth/
data/store.json
data/state.json
data/grok-key.txt
data/youtube_cookies.txt
data/messageCounts.json
data/aura.json
data/casino.json
data/nicks.json
data/pfphashes.json
data/banlist.json
data/linkperms.json
data/joinRequests.json
data/parado.json
# Temporales de escritura atomica. Solo quedan si al bot lo matan a media
# escritura; el propio bot los barre al arrancar (barrerHuerfanos).
data/*.tmp
data/ownerJids.json
data/lidMap.json
data/robo.json
# Ventana anti-repeticion de frases. Es estado del grupo y ademas cambia con
# cada mensaje: subirlo seria ruido puro en cada commit.
data/pickhistory.json
# La racha de dias seguidos de cada uno. Es estado del grupo, como el resto:
# subirlo al repo publicaria quien aparece cada dia y a que hora.
data/racha.json
# Como firma cada uno sus mensajes. Es una lista de nombres reales atada a
# telefonos reales: no sube al repo ni por asomo. Y ademas tiene que quedar
# fuera para que el `git reset --hard` del despliegue no lo pise en la VPS.
data/nombres.json
data/pfpcache/
data/music_cache/
temp/
.env
*.log

# Nunca borrar la carpeta data/ con git clean
!data/.gitkeep
!temp/.gitkeep
