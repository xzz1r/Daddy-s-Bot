node_modules/
data/auth/
data/store.json
data/state.json
data/grok-key.txt
data/youtube_cookies.txt
data/messageCounts.json
data/aura.json
data/casino.json
data/nicks.json
data/pfphashes.json
data/banlist.json
data/linkperms.json
data/joinRequests.json
data/parado.json
# Temporales de escritura atomica. Solo quedan si al bot lo matan a media
# escritura; el propio bot los barre al arrancar (barrerHuerfanos).
data/*.tmp
data/ownerJids.json
data/lidMap.json
data/robo.json
# mutes.json era el UNICO de data/ sin ignorar, y eso rompia el despliegue: al
# primer !mute, git status lo veia como fichero nuevo, actualizar.sh se negaba a
# actualizar y el arreglo que imprime —git clean -fd— lo borraba.
data/mutes.json
# Claves de mensajes para !limpiar. Sin texto, pero son ids del grupo.
data/historialGrupo.json
# Ventana anti-repeticion de frases. Es estado del grupo y ademas cambia con
# cada mensaje: subirlo seria ruido puro en cada commit.
data/pickhistory.json
# La racha de dias seguidos de cada uno. Es estado del grupo, como el resto:
# subirlo al repo publicaria quien aparece cada dia y a que hora.
data/racha.json
# Objetivo del día: si sube al repo, un reset --hard pisa el cartel en curso.
data/objetivoDia.json
# Como firma cada uno sus mensajes. Es una lista de nombres reales atada a
# telefonos reales: no sube al repo ni por asomo. Y ademas tiene que quedar
# fuera para que el `git reset --hard` del despliegue no lo pise en la VPS.
data/nombres.json
# La sesion del guardian. Es OTRA cuenta de WhatsApp: sus credenciales no suben
# al repositorio ni por asomo. Y encima, sin esta linea el despliegue se paraba
# y el arreglo que imprime —git clean -fd— la borraba, o sea que habria que
# volver a vincular al guardian en cada actualizacion.
data/authGuardian/
data/authGuardian.*/
# El numero del bot, que el escribe al conectar para que el guardian sepa a
# quien protege. Es un telefono real: fuera del repositorio publico.
data/numeroBot.json
# Quien le quito el admin al bot y cuando. Estado del grupo, y con un telefono
# dentro.
data/adminDeuda.json
# Los grupos donde el guardian ha visto al bot con admin. Es lo que le permite
# reponerlo al reconectar sin repartir admin donde nadie se lo dio.
data/guardianVistos.json
data/pfpcache/
data/music_cache/
# temp/* y no temp/: con la carpeta entera ignorada, el !temp/.gitkeep de mas
# abajo no puede volver a incluirla (git no entra en carpetas ignoradas) y un
# clon nuevo llegaba sin temp/. Lo que escribe ahi fallaba con ENOENT hasta
# que el bot arrancaba y la creaba.
temp/*
.env
# Y CUALQUIER RESPALDO DEL .env. Esto paro un despliegue de verdad: para meter
# una linea nueva en el tier del dueño se hizo `cp .env .env.bak` antes de
# tocarlo —lo sensato— y eso dejo un fichero sin seguir dentro del repositorio.
# actualizar.sh se niega a desplegar con el arbol sucio (y hace bien), asi que
# el .env quedo cambiado y el bot sin reiniciar: corriendo con la configuracion
# de antes y sin que nada lo dijera.
#
# Peor todavia: el arreglo que imprime ese guion es `git clean -fd`, que BORRA
# el respaldo. El mismo fallo que ya costo data/mutes.json y la sesion del
# guardian, por tercera vez.
.env.bak
.env.*.bak
.env.backup
*.log

# Nunca borrar la carpeta data/ con git clean
!data/.gitkeep
!temp/.gitkeep

# La marca del ritmo de reinicios: es de ESTA maquina, no del repositorio.
data/estadoReinicios.json

# La memoria de rencor: quien le gano a quien, y cuando (src/utils/rencorStore.js).
data/rencor.json

# La despensa de las acciones en disco: MP4 ya convertidos, incluidos los de
# los comandos NSFW. Nunca sube al repositorio.
data/despensa/

# El cuaderno del guardian: cuando nace y como muere. Es de ESTA maquina.
data/guardianVidas.json

# La bitacora de estados subidos al grupo: numeros del grupo, no sube nunca.
data/estadosVistos.json

# El ultimo fallo de !tt, !ig y !pin: de ESTA maquina, para npm run estado.
data/redesFallos.json

# La senyal de "quiero vincular el guardian ahora": es un acto de esta maquina.
data/vincularGuardian

# La sesion de Instagram para yt-dlp (ver conSesion en utils/redes.js).
data/instagram_cookies.txt

# El latido del bot para el guardian (ver arrancarLatidoGuardian en bot.js).
data/botLatido.json
data/botLatido.json.tmp
